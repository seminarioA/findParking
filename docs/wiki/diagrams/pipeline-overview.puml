@startuml pipeline-overview
title CI/CD Pipeline — .github/workflows/ci-cd-pipeline.yml

start
:push o pull_request a main/dev/test;

fork
  :test\n"Run Backend Unit Tests (pytest)";
fork again
  :lint\n"Lint & Security Scan (ruff + pip-audit)";
end fork

if (push a main?) then (si)
  :build-and-push\n"Build & Push Docker Images to GHCR";
  if (vars.DEPLOY_ENABLED == 'true'?) then (si)
    :deploy\n"Deploy to Production via SSH"\n(environment: production);
    stop
  else (no)
    :deploy se salta (job disabled);
    stop
  endif
else (no: PR o push a dev/test)
  :build-and-push y deploy se saltan;
  stop
endif

@enduml
