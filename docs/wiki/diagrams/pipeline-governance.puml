@startuml pipeline-governance
!theme cerulean
skinparam node {
  BackgroundColor White
  BorderColor DarkBlue
}

title Gobernanza de Implementación del Pipeline CI/CD — findParking (TOGAF Fase G)

node "Push / Pull Request" as trigger

package "Quality Gates (obligatorios)" as gates {
  [Gate 1: Unit Tests\npytest] as gate1
  [Gate 2: Lint & Security\nruff + pip-audit] as gate2
}

node "Branch Protection (main)" as protection {
  [required_status_checks:\nambos gates deben pasar\npara poder mergear] as rule
}

node "Control de Despliegue" as control {
  [Variable de repo\nDEPLOY_ENABLED] as flag
}

node "Producción" as prod {
  [Deploy real vía SSH\n(environment: production)] as deploy
}

node "Deploy omitido" as skipped {
  [Job deploy se salta\n(no falla)] as skip
}

trigger --> gate1
trigger --> gate2
gate1 --> rule
gate2 --> rule
rule --> control : merge a main
control --> deploy : DEPLOY_ENABLED == 'true'
control --> skip : DEPLOY_ENABLED != 'true'

@enduml
