@startuml pipeline-technology-architecture
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor White
skinparam defaultFontColor Black

title Arquitectura Tecnológica del Pipeline CI/CD — findParking

actor "Desarrollador" as dev

node "Control de Versiones" as vcs {
  [GitHub Repository\nseminarioA/findParking] as git
}

node "Runner de CI (GitHub Actions)" as runner {
  [test\npytest] as test
  [lint\nruff + pip-audit] as lint
  [build-and-push\ndocker build] as build
}

database "Container Registry" as registry {
  [GHCR\n6 imágenes Docker] as images
}

node "VPS de Producción" as vps {
  [docker compose\n6 servicios + redis + postgres + nginx] as stack
}

dev --> vcs : push / pull request
vcs --> runner : webhook trigger
test --> build
lint --> build
build --> images : docker push (:latest, :sha)
images --> vps : docker compose pull\n(SSH, si DEPLOY_ENABLED=true)

@enduml
