# Copy this file to api/video/.env (gitignored) and fill in real values.
# JWT_SECRET: obligatorio, >=32 caracteres. El servicio NO arranca con un valor
# por defecto/corto. Generar con: openssl rand -hex 32
# Debe ser el MISMO valor en auth/occupancy/video. (TICKET-74)
JWT_SECRET=CHANGE_ME
SECRET_KEY=CHANGE_ME_shared_jwt_secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
