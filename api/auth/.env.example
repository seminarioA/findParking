# Copy this file to api/auth/.env (gitignored) and fill in real values.
# Variables de entorno compartidas para JWT y autenticación
SECRET_KEY=CHANGE_ME_shared_jwt_secret
# JWT_SECRET: obligatorio, >=32 caracteres. El servicio NO arranca con un valor
# por defecto/corto. Generar con: openssl rand -hex 32
# Debe ser el MISMO valor en auth/occupancy/video. (TICKET-74)
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_URL=sqlite:///auth.db
# Admin inicial (opcional): si se definen ambos, create_admin.py crea este único
# admin en el primer arranque. Sin ellos, no se crea ningún admin. (TICKET-73)
# INITIAL_ADMIN_EMAIL=admin@tudominio.com
# INITIAL_ADMIN_PASSWORD=
